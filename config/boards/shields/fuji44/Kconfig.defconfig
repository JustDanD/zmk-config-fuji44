if SHIELD_FUJI44_LEFT

config ZMK_KEYBOARD_NAME
    default "Fuji44"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_FUJI44_LEFT || SHIELD_FUJI44_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_FUJI44_QUBE

config ZMK_KEYBOARD_NAME
    default "Fuji44 Qube"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif